# ==========================================
# Application Configuration
# ==========================================
# Use config.settings.production for production deployment
DJANGO_SETTINGS_MODULE=config.settings.development
# STRICT REQUIREMENT: In production, DJANGO_SECRET_KEY must be a unique, cryptographically random string (min 50 chars)
DJANGO_SECRET_KEY=change-me-in-production-super-secret-key-12345
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ==========================================
# JWT Authentication Settings
# ==========================================
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ==========================================
# Database (PostgreSQL) Configuration
# ==========================================
DATABASE_URL=postgres://shop_user:shop_password_secure_123@postgres:5432/shop_db
POSTGRES_DB=shop_db
POSTGRES_USER=shop_user
POSTGRES_PASSWORD=shop_password_secure_123
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ==========================================
# Redis & Celery Configuration
# ==========================================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ==========================================
# Security, CORS & CSRF Settings
# ==========================================
# In production, specify only the exact domain names hosting the storefront and admin panel
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# ==========================================
# Business Logic Timers
# ==========================================
ORDER_PAYMENT_TIMEOUT_MINUTES=30
GUEST_CART_RETENTION_DAYS=7

# ==========================================
# Frontend Configuration
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
INTERNAL_API_URL=http://backend:8000/api/v1
