# ==========================================
# Application Configuration
# ==========================================
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-in-production-super-secret-key-12345
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ==========================================
# Database (PostgreSQL) Configuration
# ==========================================
DATABASE_URL=postgres://shop_user:shop_password_secure_123@postgres:5432/shop_db
POSTGRES_DB=shop_db
POSTGRES_USER=shop_user
POSTGRES_PASSWORD=shop_password_secure_123
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ==========================================
# Redis & Celery Configuration
# ==========================================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ==========================================
# Security, CORS & CSRF Settings
# ==========================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==========================================
# Frontend Configuration
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
